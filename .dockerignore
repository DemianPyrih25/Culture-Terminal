# Build context for the Dockerfile. Anything private or generated stays out of the image.

# Dependencies and build output: rebuilt inside the image
**/node_modules
**/.next
**/.next-*
**/out
**/build
**/dist
**/*.tsbuildinfo
**/next-env.d.ts
.turbo
.cache

# Secrets: runtime variables only, never in a layer (also .env-backup, .envrc and the like)
**/.env*

# Private Qloo data and dumps (D29)
.probe
.private
eval/raw
**/*.dump
**/*.backup
**/*.pgdump
**/*.sql.gz

# Not needed to build or run the app
.git
.github
.claude
docs
design
tools
e2e
playwright.config.ts
coverage
test-results
playwright-report
**/*.log
**/CLAUDE.md
.vscode
.idea
**/.DS_Store
**/Thumbs.db
Dockerfile
.dockerignore
render.yaml
docker-compose.yml

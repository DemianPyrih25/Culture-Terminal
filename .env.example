# Copy to .env at the repository root and fill in. Every value here is a placeholder.
# Secrets are server-only. On Railway they are service variables, never Docker build args.

# --- Qloo ---
# Hackathon API key, sent as X-Api-Key. Leave empty in mock mode.
QLOO_API_KEY=
# The hackathon key works only against this host.
QLOO_BASE_URL=https://hackathon.api.qloo.com
# 1 = synthetic fixtures, no key, no network calls. 0 = live Qloo through the shared cache.
QLOO_MOCK=1
# Label on every Qloo call in the ledger; each parallel dev agent uses its own name.
QLOO_TAG=dev
# Network calls allowed for this QLOO_TAG before the client refuses (dev agents: 200).
QLOO_TAG_CAP=200
# Request rate limit for this process: dev agents 1.5, prod 7 (5 during deploy overlap).
QLOO_RPS=1.5

# --- Anthropic ---
# API key for the CLERK, ANALYST and GHOST models. Use the dev key locally, the prod key on Railway.
ANTHROPIC_API_KEY=
# USD cap on development LLM spend (the dev bucket).
LLM_DEV_USD_CAP=15
# USD daily breaker: Sonnet, then economy Haiku, then answer cache and replay only.
LLM_DAILY_USD_CAP=1.40
# Hard USD caps for one `pnpm llm:bench` run and one tools/llm-bench/smoke.ts run. Empty means 1.50 and 0.30.
LLM_BENCH_USD_CAP=
LLM_SMOKE_USD_CAP=

# --- Database ---
# Postgres connection string. This is the docker-compose database (`pnpm db:up`), on host port 5433.
# The app and `pnpm db:migrate` read it from this file. Tests and drizzle-kit never load .env (it
# holds live keys): they read DATABASE_URL from the shell, and with the compose default need nothing.
DATABASE_URL=postgres://ct:ct@localhost:5433/culture_terminal
# Host port for the docker-compose database (published on 127.0.0.1 only); empty keeps 5433.
# Change DATABASE_URL to match, and export DATABASE_URL in the shell for tests and drizzle-kit.
POSTGRES_HOST_PORT=
# Folder of Drizzle migrations; empty uses packages/db/drizzle (the Docker image sets its own path).
MIGRATIONS_DIR=

# --- Abuse protection and lanes ---
# Cloudflare Turnstile site key for the invisible widget (public).
TURNSTILE_SITE_KEY=
# Cloudflare Turnstile secret key, used to verify tokens server-side.
TURNSTILE_SECRET_KEY=
# Bearer token for /api/admin/* (prewarm, mode, pin). Use a long random string.
ADMIN_TOKEN=
# Salt for hashing client IPs before they are stored. Use a long random string.
IP_HASH_SALT=
# Secret for the HMAC cookie minted after a Turnstile pass. Use a long random string.
SESSION_HMAC_SECRET=
# Optional judge code that opens the reserved judge lane; rotate it if it leaks.
JUDGE_CODE=

# --- Server ---
# 0 skips the database migrations the server applies on startup; anything else runs them.
RUN_MIGRATIONS=
# How long SIGTERM waits for active runs before marking them incomplete, in ms. Keep it under
# Railway's 200 s drainingSeconds. Empty means 180000.
SHUTDOWN_GRACE_MS=
# pino log level (trace, debug, info, warn, error, fatal, silent). Empty means info.
LOG_LEVEL=

# --- Development ---
# Next.js build directory under apps/web; parallel agents set their own (e.g. .next-agent1). Never empty.
NEXT_DIST_DIR=.next
# Length in seconds of the Foundation fake agent run used to prove SSE streaming and resume.
FAKE_RUN_SECONDS=200
# Concurrent fake runs per server process. Empty means 20.
FAKE_RUN_MAX_ACTIVE=
# Fake runs allowed per rolling hour, counted in the database; beyond it POST /api/runs answers 429.
# Empty means 60.
FAKE_RUN_HOURLY_CAP=
# Finished fake runs older than this many hours are deleted with their events. Empty means 6 (minimum 1).
FAKE_RUN_RETENTION_HOURS=

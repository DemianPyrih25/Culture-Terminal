# Copy to .env at the repository root and fill in. Every value here is a placeholder.
# Secrets are server-only. On Railway they are service variables, never Docker build args.

# --- Qloo ---
# Hackathon API key, sent as X-Api-Key. Leave empty in mock mode.
QLOO_API_KEY=
# The hackathon key works only against this host.
QLOO_BASE_URL=https://hackathon.api.qloo.com
# 1 = synthetic fixtures, no key, no network calls. 0 = live Qloo through the shared cache.
QLOO_MOCK=1
# Label on every Qloo call in the ledger; each parallel dev agent uses its own name.
QLOO_TAG=dev
# Network calls allowed for this QLOO_TAG before the client refuses (dev agents: 200).
QLOO_TAG_CAP=200
# Request rate limit for this process: dev agents 1.5, prod 7 (5 during deploy overlap).
QLOO_RPS=1.5
# Fresh (network) Qloo calls per UTC day in prod; lower it during abuse. Empty means 1900. Split 60/40
# between the public and judge lanes; a lane goes replay only once its share has no room for a whole
# run (40 calls), and both lanes do below the month floor.
QLOO_DAILY_FRESH_CAP=
# 1 turns Qloo off entirely: runs take the fail-closed path (insufficient_evidence) and previews skip lookups.
QLOO_DISABLED=

# --- Anthropic ---
# API key for the CLERK, ANALYST and GHOST models. Use the dev key locally, the prod key on Railway.
ANTHROPIC_API_KEY=
# USD cap on development LLM spend (the dev bucket).
LLM_DEV_USD_CAP=15
# USD daily breaker: Sonnet, then economy Haiku, then answer cache and replay only. The judge lane
# steps down to economy at LLM_ECONOMY_USD and to replay only $0.05 short of this cap; the public lane
# at (1 - LLM_JUDGE_SHARE) of both, and no later than where a live run's $0.35 reserve stops fitting.
# 0 forces replay only at once (a way to test the breaker). Breakers reset at 00:00 UTC.
LLM_DAILY_USD_CAP=1.40
# Today's LLM spend in USD at which judge-lane briefs move to the economy ANALYST (Haiku). Empty means
# 1.00; 0 forces economy at once.
LLM_ECONOMY_USD=
# Share of the daily LLM budget held back for the judge lane, 0 to 0.9. Empty means 0.4.
LLM_JUDGE_SHARE=
# Hard USD caps for one `pnpm llm:bench` run and one tools/llm-bench/smoke.ts run. Empty means 1.50 and 0.30.
LLM_BENCH_USD_CAP=
LLM_SMOKE_USD_CAP=

# --- Database ---
# Postgres connection string. This is the docker-compose database (`pnpm db:up`), on host port 5433.
# The app and `pnpm db:migrate` read it from this file. Tests and drizzle-kit never load .env (it
# holds live keys): they read DATABASE_URL from the shell, and with the compose default need nothing.
DATABASE_URL=postgres://ct:ct@localhost:5433/culture_terminal
# Host port for the docker-compose database (published on 127.0.0.1 only); empty keeps 5433.
# Change DATABASE_URL to match, and export DATABASE_URL in the shell for tests and drizzle-kit.
POSTGRES_HOST_PORT=
# Folder of Drizzle migrations; empty uses packages/db/drizzle (the Docker image sets its own path).
MIGRATIONS_DIR=

# --- Abuse protection and lanes ---
# Cloudflare Turnstile, required before a live run or a question preview. Leave both empty locally:
# the check is then skipped (logged once). In production (NODE_ENV=production) it is required: with
# either key missing, live runs and previews are refused (503) until both are set, unless
# TURNSTILE_DISABLED=1. GET /api/health shows protection.human_check. To try it locally, use
# Cloudflare's test keys, which need no account: site key 1x00000000000000000000AA (always passes, visible) or
# 1x00000000000000000000BB (always passes, invisible), 2x00000000000000000000AB (always blocks),
# 3x00000000000000000000FF (forces an interactive challenge); secret key
# 1x0000000000000000000000000000000AA (always passes), 2x0000000000000000000000000000000AA (always
# fails), 3x0000000000000000000000000000000AA (token already spent). Production uses the keys of
# the site's own Turnstile widget (managed or invisible).
# Site key for the browser's widget (public; served by GET /api/access at runtime, not baked in).
TURNSTILE_SITE_KEY=
# Secret key, used to verify tokens with Cloudflare's siteverify.
TURNSTILE_SECRET_KEY=
# 1 runs production without the human check, on purpose (live runs then need no check). Empty keeps
# it required in production. Ignored outside production, where missing keys already skip it.
TURNSTILE_DISABLED=
# Bearer token for /api/admin/* (GET or POST /api/admin/mode {mode, reason?}). Use a long random
# string. Empty turns the admin routes off (404).
ADMIN_TOKEN=
# Salt for hashing client addresses (the right-most X-Forwarded-For entry; an IPv6 address by its
# /64) into visitor keys. Each run records its visitor's key (runs.ip_hash, cleared within an hour of
# turning 25 hours old). The public lane's per-visitor limits count them in the database, 3 an hour
# and 8 a day across restarts; one live run at a time is held in memory. No address is stored or logged. Use a long
# random string and keep it: a new salt starts every count over. Empty makes a salt at startup, so the
# counts start over on every restart (warned in production).
IP_HASH_SALT=
# Signs the two-hour cookie minted after a Turnstile pass. Use a long random string. Empty makes a
# key at startup, so a restart asks every browser to pass the check again.
SESSION_HMAC_SECRET=
# Secret of the judge link https://<host>/api/judge?token=<JUDGE_TOKEN>, which opens the judge lane
# (its own hourly and daily caps and slot, 40% of the daily budget held for it) in that browser for
# 14 days. Use a long random string, at least 32 characters (startup logs a warning under 24): the
# link is the only key to the lane, and after 20 wrong tokens in a minute every judge link answers
# 429 for the rest of the minute. Rotating it closes every judge cookie. Empty leaves the lane
# closed. JUDGE_CODE is read if this is empty, and must be as long.
JUDGE_TOKEN=
# Judge-lane live runs allowed per rolling hour, counted apart from the public lane. Empty means 20.
JUDGE_RUN_HOURLY_CAP=
# Judge-lane live runs allowed per rolling 24 hours, counted in the database. Empty means 60.
JUDGE_RUN_DAILY_CAP=
# Of AGENT_RUN_MAX_ACTIVE, the slots one server process holds for judge-lane runs, which public runs
# never take; none is held while the judge lane is closed. Empty means 1.
JUDGE_RUN_MAX_ACTIVE=
# Forces the mode on every lane for a demo: live, economy or replay_only. It replaces the breakers
# (the pre-run budget check and the Qloo client's own caps still refuse what they must). Empty uses
# the breakers. GET /api/health shows the mode, each lane's breaker and this override.
MODE_OVERRIDE=

# --- Server ---
# 0 skips the database migrations the server applies on startup; anything else runs them.
RUN_MIGRATIONS=
# How long SIGTERM waits for active runs before marking them incomplete, in ms. Keep it under
# Railway's 200 s drainingSeconds. Empty means 180000.
SHUTDOWN_GRACE_MS=
# pino log level (trace, debug, info, warn, error, fatal, silent). Empty means info.
LOG_LEVEL=
# Public-lane live agent runs allowed per rolling hour across all server processes, counted in the
# database; beyond it POST /api/runs answers 429. Empty means 20.
AGENT_RUN_HOURLY_CAP=
# Live agent runs of both lanes allowed per rolling 24 hours across all server processes, counted in
# the database; beyond it POST /api/runs answers 429. Empty means 200.
AGENT_RUN_DAILY_CAP=
# Live agent runs of both lanes one server process holds at once, JUDGE_RUN_MAX_ACTIVE of them held
# for the judge lane while it is open (so 2 public and 1 judge by default); apart from
# FAKE_RUN_MAX_ACTIVE (test runs never take these slots). Beyond it POST /api/runs answers 429. Empty means 3.
AGENT_RUN_MAX_ACTIVE=
# CLERK previews (the "Understood as" panel) one server process allows per rolling hour. Empty means 120.
PREVIEW_HOURLY_CAP=

# --- Development ---
# Next.js build directory under apps/web; parallel agents set their own (e.g. .next-agent1). Never empty.
NEXT_DIST_DIR=.next
# Length in seconds of the Foundation fake agent run used to prove SSE streaming and resume.
FAKE_RUN_SECONDS=200
# Concurrent fake runs per server process; agent runs do not count against it. Empty means 20.
FAKE_RUN_MAX_ACTIVE=
# Fake runs allowed per rolling hour, counted in the database; beyond it POST /api/runs answers 429.
# Empty means 60.
FAKE_RUN_HOURLY_CAP=
# Finished fake runs older than this many hours are deleted with their events. Empty means 6 (minimum 1).
FAKE_RUN_RETENTION_HOURS=

# Public origin for absolute og:image URLs on showcase permalinks; a bare host gets https://.
# Unset: RAILWAY_PUBLIC_DOMAIN on Railway, else Next falls back to http://localhost:<PORT>.
PUBLIC_SITE_URL=

# Public data (company_financials, area_economics). Both are server-only.
# SEC EDGAR asks for a User-Agent naming the product and a real contact email. Unset: SEC calls report
# "not configured" and the tool says so; the app still starts. QLOO_MOCK=1 answers both from mock data.
SEC_USER_AGENT=
# Census Data API key (free at api.census.gov/data/key_signup.html). Keyless requests are refused, so
# unset leaves Census not configured the same way. Never logged, cached or shown in provenance.
CENSUS_API_KEY=
